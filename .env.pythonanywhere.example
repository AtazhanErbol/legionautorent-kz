# Copy to .env.pythonanywhere on the host. Never upload the local .env.
ENVIRONMENT=staging
HOSTING_PLATFORM=pythonanywhere
DEBUG=false
SECRET_KEY=replace-with-generated-secret-at-least-50-characters-long
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@PG_HOST:PG_PORT/legion
DB_SSLMODE=prefer
SITE_URL=https://legionautorent.kz
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com,legionautorent.kz,www.legionautorent.kz
CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com,https://legionautorent.kz,https://www.legionautorent.kz
ADMIN_PATH=control-legion/
ANALYTICS_ENABLED=false
CANONICAL_HOST_REDIRECT=false
SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=true
PAGE_CACHE_TIMEOUT=60
# Leave blank to use the editable CMS settings.
GTM_ID=
WHATSAPP_NUMBER=
