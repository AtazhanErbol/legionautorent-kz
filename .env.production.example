ENV_FILE=.env.production
ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=replace-with-generated-secret-at-least-50-characters-long
# URL-safe random values; separate administrator and application credentials.
POSTGRES_PASSWORD=replace-with-generated-admin-password
APP_DB_PASSWORD=replace-with-generated-application-password
DATABASE_URL=postgresql://legion:replace-with-generated-application-password@db:5432/legion
DB_SSLMODE=prefer
SITE_URL=https://legionautorent.kz
ALLOWED_HOSTS=legionautorent.kz,www.legionautorent.kz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://legionautorent.kz
SECURE_SSL_REDIRECT=true
ANALYTICS_ENABLED=false
ADMIN_PATH=control-legion/
PAGE_CACHE_TIMEOUT=60
# Change to ./deploy/nginx.conf after obtaining a certificate; then ENVIRONMENT=production.
NGINX_CONFIG=./deploy/nginx-bootstrap.conf

# Optional overrides; leave blank to use the imported, editable Site Settings.
GTM_ID=
WHATSAPP_NUMBER=
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=172.30.0.10
